{
    "name": "spnuke/alfred-workflow-spotify-mini-companion",
    "description": "Alfred workflow companion to Spotify Mini Player that nukes the currently-playing track from every owned playlist except 'Nuked'.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-sqlite3": "*",
        "ext-json": "*",
        "jwilsson/spotify-web-api-php": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Spnuke\\": "src/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spnuke\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit --colors=always"
    }
}
